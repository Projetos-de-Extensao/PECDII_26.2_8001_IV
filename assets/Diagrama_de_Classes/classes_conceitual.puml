@startuml classes_conceitual
!pragma layout smetana
title Playmakerz: Diagrama de Classes Conceitual (v0.3)

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #1F3A5F
skinparam ArrowColor #1F3A5F
skinparam NoteBackgroundColor #FFF8DC
hide empty methods
hide circle

abstract class Usuario {
  nome
  email
  telefone
}

class Atleta {
  nome
  email
  telefone
  dataDeNascimento
  objetivos
}

class Responsavel {
  telefone
}

class Profissional {
  especialidade
}

class DisponibilidadeProfissional {
  diaSemana
  horaInicio
  horaFim
}

class Funcionario {
  cargo
}

class Espaco {
  nome
  tipo
  capacidade
}

class Equipamento {
  nome
  tipo
}

class Agendamento {
  inicio
  fim
  modalidade
  limiteParticipantes
  situacao
  observacoes
  motivoCancelamento
}

class ParticipacaoAgendamento {
  tipo
  situacao
  observacoes
  motivoCancelamento
}

Usuario <|-- Atleta
Usuario <|-- Responsavel
Usuario <|-- Profissional
Usuario <|-- Funcionario

Responsavel "0..1" -- "0..*" Atleta : responsavel por >

Agendamento "1" -- "1..*" ParticipacaoAgendamento : possui >
Atleta "1" -- "0..*" ParticipacaoAgendamento : participa >
Profissional "1" -- "0..*" DisponibilidadeProfissional : possui >
Agendamento "*" -- "1" Profissional : conduzido por >
Agendamento "*" -- "1" Espaco : ocorre em >
Agendamento "*" -- "0..*" Equipamento : utiliza >
Agendamento "*" -- "1" Funcionario : registrado por >

note bottom of Agendamento
  Verificar conflitos de horario de
  atletas, profissionais e equipamentos.

  O espaco deve respeitar sua capacidade
  considerando as vagas reservadas.
end note

note bottom of Atleta
  Atleta menor de idade precisa
  de um Responsavel.
end note

@enduml
